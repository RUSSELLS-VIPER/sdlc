      // Gather updated input properties from input boxes
      const roleValue = document.getElementById("adminUpdateTargetRole").value;
      const nameValue = document.getElementById("adminUpdateTargetName").value.trim();
      const cityValue = document.getElementById("adminUpdateTargetCity").value.trim();
      const districtValue = document.getElementById("adminUpdateTargetDistrict").value.trim();
      const localityValue = document.getElementById("adminUpdateTargetLocality").value.trim();
      const phoneValue = document.getElementById("adminUpdateTargetPhone").value.trim();

      // Build request data payload object dynamically
      const requestPayload = {
        role: roleValue
      };

      // Only append optional profile keys if values are explicitly provided
      if (nameValue) requestPayload.name = nameValue;
      if (cityValue) requestPayload.city = cityValue;
      if (districtValue) requestPayload.district = districtValue;
      if (localityValue) requestPayload.locality = localityValue;
      if (phoneValue) requestPayload.phoneNo = Number(phoneValue);

      const requestUrlPath = `/api/admin/admin-update-role/${userId}`;

      // Fire request payload through your base application handler wrapper 
      // Using "PATCH" method with active authorization token headers enabled
      const apiResponsePayload = await sendRequest(requestUrlPath, "PATCH", requestPayload, true);

      // Print returned execution payload directly inside your dark text-area terminal view
      if (typeof writeResponse === "function") {
        writeResponse(apiResponsePayload.data, apiResponsePayload.status);
      } else {
        console.log(`Admin Role Modification Output Frame (${apiResponsePayload.status}):`, apiResponsePayload.data);
      }
    }


