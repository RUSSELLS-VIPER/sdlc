<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Real Estate API Tester</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #1f2937;
    }

    .container {
      max-width: 1100px;
      margin: 24px auto;
      padding: 0 16px;
    }

    h1 {
      margin-bottom: 8px;
    }

    .hint {
      margin-bottom: 16px;
      color: #4b5563;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 16px;
    }

    .card {
      background: #fff;
      border: 1px solid #dbe2ea;
      border-radius: 10px;
      padding: 14px;
    }

    .card h3 {
      margin: 0 0 12px;
    }

    label {
      display: block;
      font-size: 12px;
      margin-bottom: 5px;
      color: #4b5563;
    }

    input,
    select,
    button,
    textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 8px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      margin-bottom: 10px;
      font-size: 14px;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    button {
      border: none;
      cursor: pointer;
      background: #0f766e;
      color: #fff;
      font-weight: 600;
    }

    button:hover {
      background: #115e59;
    }

    .response {
      margin-top: 16px;
      background: #0f172a;
      color: #e2e8f0;
      border-radius: 10px;
      padding: 14px;
      white-space: pre-wrap;
      word-break: break-word;
      min-height: 220px;
    }

    .token-box {
      background: #fff;
      border: 1px solid #dbe2ea;
      border-radius: 10px;
      padding: 14px;
      margin-bottom: 16px;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .small {
      font-size: 12px;
      color: #6b7280;
      margin-top: -4px;
      margin-bottom: 8px;
    }
  </style>
</head>

<body>
  <div class="container">
    <h1>Real Estate API Tester</h1>
    <h2>
      Swagger Documentation <a href="http://localhost:8000/api-docs/">link</a>
    </h2>

    <div class="token-box">
      <div class="row">
        <div>
          <label for="baseUrl">Base URL (without /api path)</label>
          <input id="baseUrl" value="<%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>"
            placeholder="http://localhost:8000" />
        </div>
        <div>
          <label for="token">JWT Token</label>
          <input id="token" placeholder="Paste token or login to auto-fill" />
        </div>
      </div>
      <div class="row">
        <div>
          <label for="currentUserId">Current User ID</label>
          <input id="currentUserId" placeholder="Auto-filled after login" />
        </div>
        <div>
          <label for="commonPropertyId">Common Property ID</label>
          <input id="commonPropertyId" placeholder="Use for like/favorite/profile tests" />
        </div>
      </div>
      <button id="saveToken">Save Token</button>
    </div>

    <div class="grid">
      <div class="card">
        <h3>Register</h3>
        <label>Name</label>
        <input id="regName" value="Test User" />
        <label>Email</label>
        <input id="regEmail" value="test@example.com" />
        <label>Password</label>
        <input id="regPassword" type="password" value="123456" />
        <label>Role</label>
        <select id="regRole">
          <option value="user">user</option>
          <option value="agent">agent</option>
          <option value="admin">admin</option>
        </select>
        <button onclick="register()">POST /api/auth/register</button>
      </div>

      <div class="card">
        <h3>Verify Email</h3>
        <label>Email</label>
        <input id="verifyEmail" value="test@example.com" />
        <label>OTP</label>
        <input id="verifyOtp" placeholder="Enter OTP from email" />
        <button onclick="verifyEmail()">POST /api/auth/verify-email</button>
      </div>

      <div class="card">
        <h3>Login</h3>
        <label>Email</label>
        <input id="loginEmail" value="test@example.com" />
        <label>Password</label>
        <input id="loginPassword" type="password" value="123456" />
        <button onclick="login()">POST /api/auth/login</button>
      </div>

      <div class="card">
        <h3>Create Property</h3>
        <label>Title</label>
        <input id="createTitle" value="2BHK Apartment" />
        <label>Description</label>
        <textarea id="createDescription">
Near metro station, ready to move.</textarea>
        <label>Price</label>
        <input id="createPrice" value="7800000" />
        <label>Address</label>
        <input id="createAddress" value="Kolkata, India" />
        <label>BHK Type</label>
        <input id="createBhkType" value="2BHK" />
        <label>Sq.FT</label>
        <input id="createSqFt" value="1200" />
        <label>Apartment Type</label>
        <input id="createApartmentType" value="Apartment" />
        <label>Property Type</label>
        <select id="createPropertyType">
          <option value="apartment">apartment</option>
          <option value="home">home</option>
          <option value="office">office</option>
          <option value="villa">villa</option>
          <option value="rental">rental</option>
        </select>
        <label>Project Status</label>
        <select id="createProjectStatus">
          <option value="Completed">Completed</option>
          <option value="Ongoing">Ongoing</option>
        </select>
        <label>Image (optional)</label>
        <input id="createImage" type="file" accept="image/*" />
        <button onclick="createProperty()">POST /api/properties</button>
      </div>

      <div class="card">
        <h3>Get Properties</h3>
        <button onclick="getProperties()">GET /api/properties</button>
        <label>Property ID</label>
        <input id="propertyId" placeholder="Property id for get/update/delete" />
        <div class="small">Tip: you can reuse Common Property ID above</div>
        <button onclick="getPropertyById()">GET /api/properties/:id</button>
      </div>

      <div class="card">
        <h3>Update Property</h3>
        <label>Property ID</label>
        <input id="updateId" placeholder="Property id" />
        <label>Title (optional)</label>
        <input id="updateTitle" />
        <label>Description (optional)</label>
        <textarea id="updateDescription"></textarea>
        <label>Price (optional)</label>
        <input id="updatePrice" />
        <label>Address (optional)</label>
        <input id="updateAddress" />
        <label>BHK Type (optional)</label>
        <input id="updateBhkType" />
        <label>Sq.FT (optional)</label>
        <input id="updateSqFt" />
        <label>Apartment Type (optional)</label>
        <input id="updateApartmentType" />
        <label>Property Type (optional)</label>
        <select id="updatePropertyType">
          <option value="">-- Select --</option>
          <option value="apartment">apartment</option>
          <option value="home">home</option>
          <option value="office">office</option>
          <option value="villa">villa</option>
          <option value="rental">rental</option>
        </select>
        <label>Project Status (optional)</label>
        <select id="updateProjectStatus">
          <option value="">-- Select --</option>
          <option value="Completed">Completed</option>
          <option value="Ongoing">Ongoing</option>
        </select>
        <label>Image (optional)</label>
        <input id="updateImage" type="file" accept="image/*" />
        <button onclick="updateProperty()">PUT /api/properties/:id</button>
      </div>

      <div class="card">
        <h3>Delete Property</h3>
        <label>Property ID</label>
        <input id="deleteId" placeholder="Property id" />
        <button onclick="deleteProperty()">DELETE /api/properties/:id</button>
      </div>

      <div class="card">
        <h3>Like / Unlike Property</h3>
        <label>Property ID</label>
        <input id="likeId" placeholder="Property id" />
        <button onclick="toggleLike()">POST /api/properties/:id/like</button>
      </div>

      <div class="card">
        <h3>Get User Profile</h3>
        <label>User ID</label>
        <input id="profileUserId" placeholder="User id (or Current User ID)" />
        <button onclick="getUserProfile()">GET /api/users/profile/:id</button>
      </div>

      <div class="card">
        <h3>Update Profile</h3>
        <label>Name (optional)</label>
        <input id="profileName" placeholder="New name" />
        <label>Email (optional)</label>
        <input id="profileEmail" placeholder="New email" />


        <label>City (optional)</label>
        <input id="profileCity" placeholder="City" />
        <label>District (optional)</label>
        <input id="profileDistrict" placeholder="District" />
        <label>Locality (optional)</label>
        <input id="profileLocality" placeholder="Locality" />
        <label>Phone No. (optional)</label>
        <input id="profilePhoneNo" placeholder="Phone No." />


        <label>Profile Image (optional)</label>
        <input id="profileImage" type="file" accept="image/*" />
        <button onclick="updateUserProfile()">
          PUT /api/users/profile/update
        </button>
      </div>

      <div class="card">
        <h3>Toggle Favorite Property</h3>
        <label>Property ID</label>
        <input id="favoritePropertyId" placeholder="Property id" />
        <button onclick="toggleFavorite()">
          POST /api/users/favorites/:propertyId
        </button>
      </div>

      <div class="card">
        <h3>Get My Favorites</h3>
        <button onclick="getMyFavorites()">
          GET /api/users/favorites/my-list
        </button>
      </div>




      <div class="card" style="border-left: 4px solid #0f766e;">
        <h3>Search Chat Contacts</h3>
        <div class="small">Performs real-time role-based filtering using your session token.</div>

        <label for="chatSearchInput">Search by Name (Filters instantly)</label>
        <input id="chatSearchInput" placeholder="Type a username..." oninput="searchUsersToChat()" />

        <button onclick="searchUsersToChat()">GET /api/users/search-user-to-chat</button>

        <div id="chatSearchOutputContainer"
          style="margin-top: 12px; display: flex; flex-direction: column; gap: 8px; max-height: 250px; overflow-y: auto;">
          <p style="font-size: 13px; color: #6b7280; text-align: center; margin: 10px 0;">Start typing above to retrieve
            real-time data matches...</p>
        </div>
      </div>

      <div class="card" style="border-left: 4px solid #14b8a6; grid-column: span 1;">
        <h3>Chat History Log</h3>
        <div class="small">Renders a chronological bidirectional conversation thread between you and the target user.
        </div>

        <label for="chatHistoryUserId">Target User ID</label>
        <input id="chatHistoryUserId" placeholder="Click a user from search results or paste an explicit MongoDB ID" />

        <button onclick="loadChatHistory()">GET /api/users/history/:userId</button>

        <div id="chatHistoryWindow"
          style="margin-top: 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; display: flex; flex-direction: column; min-height: 280px; max-height: 350px;">

          <div id="chatParticipantBanner"
            style="background: #f1f5f9; border-bottom: 1px solid #e2e8f0; padding: 10px 14px; border-top-left-radius: 9px; border-top-right-radius: 9px; display: none; align-items: center; gap: 10px;">
          </div>

          <div id="chatMessageStream"
            style="flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 12px;">
            <p style="font-size: 13px; color: #6b7280; text-align: center; margin: auto;">Select an active user contact
              or provide an operational ID to trace timelines...</p>
          </div>

          <!-- Scrollable Message Stream Container -->
          <div id="chatMessageStream"
            style="flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 12px;">
            <p style="font-size: 13px; color: #6b7280; text-align: center; margin: auto;">Select an active user contact
              or provide an operational ID to trace timelines...</p>
          </div>

          <!-- Integrated Direct Message Despatcher Row Node -->
          <div id="chatInputBarArea"
            style="display: flex; gap: 8px; padding: 10px; background: #f1f5f9; border-top: 1px solid #e2e8f0; border-bottom-left-radius: 9px; border-bottom-right-radius: 9px;">
            <input id="chatOutgoingTextMessage" placeholder="Type your message text here..."
              style="margin-bottom: 0; flex: 1;" onkeydown="if(event.key === 'Enter') executeSendMessage()" />
            <button onclick="executeSendMessage()" style="margin-bottom: 0; width: auto; padding: 0 16px;">Send</button>
          </div>

        </div>
      </div>



      <!-- User Notifications Timeline API Block -->
      <div class="card" style="border-left: 4px solid #3b82f6;">
        <h3 style="margin: 0;">GET /api/users/my-notifications</h3>
        <div class="small" style="margin-bottom: 12px;">Fetch all status updates, buy requests, and role changes
          explicitly targeted to your current profile session.</div>

        <button onclick="testUserNotificationsAPI()">Fetch My Notifications</button>
      </div>


      <div class="card" style="border-left: 4px solid #0f766e;">
        <h3>Admin Dashboard</h3>
        <div class="small">Requires authorization token with an 'admin' role.</div>

        <label>Timeframe (Part 3 Wave Graph)</label>
        <select id="adminTimeframe">
          <option value="month">Month (Default)</option>
          <option value="week">Week</option>
          <option value="year">Year</option>
        </select>

        <button onclick="getAdminDashboard()">GET /api/admin/dashboard</button>
      </div>

      <div class="card" style="border-left: 4px solid #0f766e;">
        <h3 style="margin: 0;">GET /api/admin/customers-list</h3>
        <div class="small" style="margin-bottom: 12px;">Fetch regular customer directory profile records with a limit
          index of 16 records per page slice.</div>

        <div style="display: flex; gap: 10px; margin-bottom: 10px; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 120px;">
            <label style="font-size: 11px;">Query Page Index</label>
            <input id="adminCustomerPageNum" type="number" value="1" min="1" style="margin-bottom: 0;" />
          </div>
          <div style="flex: 2; min-width: 200px;">
            <label style="font-size: 11px;">Search Parameter Text (Optional)</label>
            <input id="adminCustomerSearchText" placeholder="Filter by Name / Email fragment string..."
              style="margin-bottom: 0;" />
          </div>
        </div>

        <button onclick="testAdminCustomerListAPI()">Execute API Request Context</button>
      </div>




      <div class="card" style="border-left: 4px solid #b91c1c;">
        <h3 style="margin: 0;">PATCH /api/admin/admin-update-role/:userId</h3>
        <div class="small" style="margin-bottom: 12px;">Modify a user's role (e.g., upgrading to an Agent) and update
          their optional profile fields by database ID.</div>

        <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
          <div>
            <label style="font-size: 11px;">Target User ID (Required)</label>
            <input id="adminUpdateTargetUserId" placeholder="e.g., 6a1c688f7801aa3029a13ac0" />
          </div>

          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 120px;">
              <label style="font-size: 11px;">Account Role Assignment</label>
              <select id="adminUpdateTargetRole"
                style="width: 100%; padding: 6px; border-radius: 4px; border: 1px solid #ccc;">
                <option value="user">User (Regular Customer)</option>
                <option value="agent">Agent (Real Estate Broker)</option>
                <option value="admin">Admin (System Controller)</option>
              </select>
            </div>
            <div style="flex: 1; min-width: 150px;">
              <label style="font-size: 11px;">Full Name (Optional)</label>
              <input id="adminUpdateTargetName" placeholder="Update Name..." style="margin-bottom: 0;" />
            </div>
          </div>

          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 120px;">
              <label style="font-size: 11px;">City</label>
              <input id="adminUpdateTargetCity" placeholder="Kolkata" style="margin-bottom: 0;" />
            </div>
            <div style="flex: 1; min-width: 120px;">
              <label style="font-size: 11px;">District</label>
              <input id="adminUpdateTargetDistrict" placeholder="Howrah" style="margin-bottom: 0;" />
            </div>
            <div style="flex: 1; min-width: 120px;">
              <label style="font-size: 11px;">Locality</label>
              <input id="adminUpdateTargetLocality" placeholder="Liluah" style="margin-bottom: 0;" />
            </div>
            <div style="flex: 1; min-width: 140px;">
              <label style="font-size: 11px;">Phone No</label>
              <input id="adminUpdateTargetPhone" type="number" placeholder="9830012345" style="margin-bottom: 0;" />
            </div>
          </div>
        </div>

        <button onclick="testAdminUpdateRoleAPI()">Execute Role Upgrade & Patch</button>
      </div>




      <!-- Property Inquiry Test Module Frame -->
      <div class="card" style="border-left: 4px solid #f59e0b;">
        <h3 style="margin: 0;">POST /api/client/property/:propertyId/inquiry</h3>
        <div class="small" style="margin-bottom: 12px;">Submit a contact inquiry with optional metadata contact
          parameters info overrides.</div>

        <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
          <div>
            <label style="font-size: 11px;">Target Property ID (Required)</label>
            <input id="inquiryPropertyTargetId" placeholder="e.g., 6a1c92a17801aa3029a15b01" />
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
            <div>
              <label style="font-size: 11px;">Custom Name (Optional override)</label>
              <input id="inquiryCustomName" placeholder="Leave empty for profile default" />
            </div>
            <div>
              <label style="font-size: 11px;">Custom Email (Optional override)</label>
              <input id="inquiryCustomEmail" type="email" placeholder="Leave empty for profile default" />
            </div>
          </div>
          <div>
            <label style="font-size: 11px;">Phone Number (Optional)</label>
            <input id="inquiryPhoneNo" placeholder="e.g., +91 98300 12345" />
          </div>
          <div>
            <label style="font-size: 11px;">Inquiry / Proposal Message (Required)</label>
            <textarea id="inquiryMessageText"
              placeholder="Write your property questions or offer parameters context here..."
              style="width: 100%; height: 70px; padding: 6px; border-radius: 4px; border: 1px solid #ccc; font-family: inherit; font-size: 13px; box-sizing: border-box;"></textarea>
          </div>
        </div>

        <button onclick="testPropertyInquirySubmission()">Submit Explicit Inquiry</button>
      </div>






      <!-- Agent Analytical Dashboard View Block -->
      <div class="card" style="border-left: 4px solid #ec4899;">
        <h3 style="margin: 0;">GET /api/agent/dashboard-summary</h3>
        <div class="small" style="margin-bottom: 12px;">Pull critical real estate operational KPIs, active inventory
          properties listings arrays, and pie chart distribution datasets.</div>

        <button onclick="loadAgentDashboardOverviewData()" style="margin-bottom: 15px;">Run Dashboard Analytics</button>

        <!-- Dynamic KPI Panels Workspace Block -->
        <div id="agentKpiRow"
          style="display:none; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-bottom: 15px;">
          <div
            style="background: #f8fafc; padding: 12px; border: 1px solid #e2e8f0; border-radius: 6px; text-align: center;">
            <div style="font-size: 11px; color: #64748b; font-weight: 600; text-transform: uppercase;">Total Inquiries
            </div>
            <div id="kpiTotalInquiries" style="font-size: 20px; font-weight: bold; color: #0f172a; margin-top: 4px;">0
            </div>
          </div>
          <div
            style="background: #f0fdf4; padding: 12px; border: 1px solid #bbf7d0; border-radius: 6px; text-align: center;">
            <div style="font-size: 11px; color: #166534; font-weight: 600; text-transform: uppercase;">Properties Sold
            </div>
            <div id="kpiPropertiesSold" style="font-size: 20px; font-weight: bold; color: #15803d; margin-top: 4px;">0
            </div>
          </div>
          <div
            style="background: #eff6ff; padding: 12px; border: 1px solid #bfdbfe; border-radius: 6px; text-align: center;">
            <div style="font-size: 11px; color: #1e40af; font-weight: 600; text-transform: uppercase;">Available
              Listings</div>
            <div id="kpiPropertiesAvailable"
              style="font-size: 20px; font-weight: bold; color: #1d4ed8; margin-top: 4px;">0</div>
          </div>
        </div>

        <!-- Simulated Pie Chart Graph Output Map Block -->
        <div id="agentPieChartVisual"
          style="display:none; background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px; margin-bottom: 15px; font-size: 12px;">
          <div style="font-weight: 600; color: #475569; margin-bottom: 8px;">📊 Pie Chart Breakdown Data:</div>
          <div style="display: flex; gap: 20px; align-items: center;">
            <div>🟢 Available Ratio Count: <strong id="pieAvailableValue">0</strong></div>
            <div>🔴 Sold Ratio Count: <strong id="pieSoldValue">0</strong></div>
          </div>
        </div>

        <!-- Inventory Database Records Table Frame -->
        <div id="agentPropertiesGridFrame"
          style="display: none; width: 100%; overflow-x: auto; border-radius: 6px; border: 1px solid #e2e8f0;">
          <table style="width: 100%; border-collapse: collapse; font-size: 12px; text-align: left; background: #fff;">
            <thead>
              <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #475569;">
                <th style="padding: 8px;">Property Title</th>
                <th style="padding: 8px;">Location</th>
                <th style="padding: 8px;">Price</th>
                <th style="padding: 8px;">Status</th>
              </tr>
            </thead>
            <tbody id="agentPropertiesTableBody" style="color: #334155;">
              <!-- Item rows append here dynamically -->
            </tbody>
          </table>
        </div>
      </div>




      <div class="card" style="border-left: 4px solid #10b981;">
        <h3 style="margin: 0;">PATCH /api/agent/inquiry/:inquiryId/action</h3>
        <div class="small" style="margin-bottom: 12px;">Approve or disapprove a pending user property inquiry.
          (Approving automatically flips the listing status to 'Sold').</div>

        <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
          <div>
            <label style="font-size: 11px;">Target Inquiry ID (Required)</label>
            <input id="agentInquiryTargetId" placeholder="e.g., 6a1c9df87801aa3029a15f88" />
          </div>

          <div>
            <label style="font-size: 11px;">Select Decision Action</label>
            <select id="agentInquiryActionValue"
              style="width: 100%; padding: 6px; border-radius: 4px; border: 1px solid #ccc;">
              <option value="approved">Approve Inquiry (Mark Property as Sold)</option>
              <option value="disapproved">Disapprove Inquiry (Keep Property Available)</option>
            </select>
          </div>
        </div>

        <button onclick="testAgentInquiryActionAPI()">Process Inquiry Decision</button>
      </div>





      <!-- Agent Leads Grid Viewer Table Block -->
      <!-- Paginated Agent Leads Grid Viewer Table Block -->
      <div class="card" style="border-left: 4px solid #8b5cf6;">
        <h3 style="margin: 0;">GET /api/agent/agent/leads?page=:pageNum</h3>
        <div class="small" style="margin-bottom: 12px;">Fetch incoming property inquiry sheets (16 records max per page
          slice) and display elements inside a table matrix grid.</div>

        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 15px;">
          <div style="width: 120px;">
            <label style="font-size: 11px;">Target Page Index</label>
            <input id="agentLeadsTargetPage" type="number" value="1" min="1" style="margin-bottom: 0; padding: 5px;" />
          </div>
          <button onclick="fetchAndDisplayAgentLeadsTable()" style="align-self: flex-end; height: 36px;">Load Leads
            Table Page</button>
        </div>

        <!-- Response Output Table Container Workspace -->
        <div id="leadsTableContainer"
          style="display: none; width: 100%; overflow-x: auto; margin-top: 10px; border-radius: 6px; border: 1px solid #e2e8f0;">
          <div id="leadsPaginationMeta"
            style="background: #f1f5f9; padding: 8px 12px; font-size: 11px; color: #475569; font-weight: 500; border-bottom: 1px solid #e2e8f0;">
