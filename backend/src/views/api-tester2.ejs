    async function fetchAndDisplayAgentLeadsTable() {
      const tableContainer = document.getElementById("leadsTableContainer");
      const tableBody = document.getElementById("leadsTableBody");
      const metaContainer = document.getElementById("leadsPaginationMeta");

      const searchName = document.getElementById("agentLeadsSearchName").value.trim();
      const pageNum = document.getElementById("agentLeadsTargetPage").value.trim() || 1;

      tableBody.innerHTML = "";
      metaContainer.innerHTML = "";
      tableContainer.style.display = "none";

      // Construct the query string paths smoothly
      let requestUrlPath = `/api/agent/agent/leads?page=${pageNum}`;
      if (searchName) {
        requestUrlPath += `&search=${encodeURIComponent(searchName)}`;
      }

      const responseDataBlock = await sendRequest(requestUrlPath, "GET", null, true);

      if (typeof writeResponse === "function") {
        writeResponse(responseDataBlock.data, responseDataBlock.status);
      }

      if (responseDataBlock.status === 200 && responseDataBlock.data && responseDataBlock.data.leads) {
        const leadsList = responseDataBlock.data.leads;
        const pagination = responseDataBlock.data.pagination;

        if (pagination) {
          metaContainer.innerHTML = `Showing page ${pagination.currentPage} of ${pagination.totalPages} — Total filtered leads: ${pagination.totalLeads}`;
        }

        if (leadsList.length === 0) {
          tableBody.innerHTML = `<tr><td colspan="4" style="padding: 15px; text-align: center; color: #64748b; font-style: italic;">No active inquiry leads located matching query filters.</td></tr>`;
        } else {
          leadsList.forEach(leadItem => {
            const rowElement = document.createElement("tr");
            rowElement.style.borderBottom = "1px solid #f1f5f9";

            const buyerName = leadItem.name || "--";
            const buyerEmail = leadItem.email || "--";
            const buyerMessage = leadItem.messageText || "--";
            const propertyTitle = leadItem.propertyId ? leadItem.propertyId.title : `<span style="color: #ef4444;">[Property Deleted]</span>`;

            rowElement.innerHTML = `
                <td style="padding: 10px; font-weight: 500;">${buyerName}</td>
                <td style="padding: 10px; color: #64748b;">${buyerEmail}</td>
                <td style="padding: 10px; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${buyerMessage}">${buyerMessage}</td>
                <td style="padding: 10px; color: #0f172a; font-weight: 500;">${propertyTitle}</td>
              `;
            tableBody.appendChild(rowElement);
          });
        }
        tableContainer.style.display = "block";
      } else {
        const errorMsg = responseDataBlock.data && responseDataBlock.data.message ? responseDataBlock.data.message : "Could not complete text matching filter loop query.";
        alert(`Error (${responseDataBlock.status}): ${errorMsg}`);
      }
    }




    async function testSoftDeleteInquiryAPI() {
      const inquiryId = document.getElementById("deleteInquiryTargetId").value.trim();

      if (!inquiryId) {
        alert("Please enter a valid Target Inquiry ID to delete.");
        return;
      }

      // Confirm the intent before running a destructive delete call
      if (!confirm("Are you sure you want to remove this inquiry from view panels?")) {
        return;
      }

      const requestUrlPath = `/api/agent/inquiry/${inquiryId}`;

      // Fire request payload through your base application handler wrapper 
      // Using "DELETE" method with active user/agent auth headers enabled
      const responseDataBlock = await sendRequest(requestUrlPath, "DELETE", null, true);

      // Print returned execution payload directly inside your dark text-area terminal view
      if (typeof writeResponse === "function") {
        writeResponse(responseDataBlock.data, responseDataBlock.status);
      } else {
        console.log(`Soft Delete Output Frame (${responseDataBlock.status}):`, responseDataBlock.data);
      }

      // Optional UX: Alert success or clear input context if request passes clean
      if (responseDataBlock.status === 200) {
        document.getElementById("deleteInquiryTargetId").value = "";
      }
    }


