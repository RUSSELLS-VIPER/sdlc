      if (resultResponse.status === 201) {
        document.getElementById("inquiryMessageText").value = "";
      }
    }






    async function loadAgentDashboardOverviewData() {
      const kpiRow = document.getElementById("agentKpiRow");
      const pieChartFrame = document.getElementById("agentPieChartVisual");
      const tableFrame = document.getElementById("agentPropertiesGridFrame");
      const tableBody = document.getElementById("agentPropertiesTableBody");

      // Clear layout state flags
      tableBody.innerHTML = "";
      kpiRow.style.display = "none";
      pieChartFrame.style.display = "none";
      tableFrame.style.display = "none";

      const responsePayload = await sendRequest("/api/agent/dashboard-summary", "GET", null, true);

      if (typeof writeResponse === "function") {
        writeResponse(responsePayload.data, responsePayload.status);
      }

      if (responsePayload.status === 200 && responsePayload.data) {
        const data = responsePayload.data;

        // 1. Map KPI Counts
        document.getElementById("kpiTotalInquiries").innerText = data.dashboardKPIs.totalInquiries;
        document.getElementById("kpiPropertiesSold").innerText = data.dashboardKPIs.propertiesSold;
        document.getElementById("kpiPropertiesAvailable").innerText = data.dashboardKPIs.propertiesAvailable;

        // 2. Map Pie Chart Simulation Metrics
        document.getElementById("pieAvailableValue").innerText = data.pieChartData.datasets[0];
        document.getElementById("pieSoldValue").innerText = data.pieChartData.datasets[1];

        // 3. Populate Asset Inventory Table Grid
        const properties = data.propertiesList || [];
        if (properties.length === 0) {
          tableBody.innerHTML = `<tr><td colspan="4" style="padding: 12px; text-align: center; color: #94a3b8; font-style: italic;">No listings linked to this agent account profiles.</td></tr>`;
        } else {
          properties.forEach(item => {
            const tr = document.createElement("tr");
            tr.style.borderBottom = "1px solid #f1f5f9";

            const badgeColor = item.status === "Available" ? "#1d4ed8" : "#15803d";
            const badgeBg = item.status === "Available" ? "#eff6ff" : "#f0fdf4";

            tr.innerHTML = `
                        <td style="padding: 8px; font-weight: 500; color:#0f172a;">${item.title}</td>
                        <td style="padding: 8px; color: #64748b;">${item.locality || "--"}, ${item.city || ""}</td>
                        <td style="padding: 8px; font-weight:600;">₹${item.price.toLocaleString("en-IN")}</td>
                        <td style="padding: 8px;">
                            <span style="padding: 2px 6px; font-size:10px; font-weight:700; border-radius:4px; color:${badgeColor}; background:${badgeBg};">${item.status}</span>
                        </td>
                    `;
            tableBody.appendChild(tr);
          });
        }

        // Reveal organized dashboard components cleanly
        kpiRow.style.display = "grid";
        pieChartFrame.style.display = "block";
        tableFrame.style.display = "block";
      } else {
        alert(`Dashboard Sync Failure (${responsePayload.status}). Verify active Agent account tokens parameters.`);
      }
    }





