    async function testPropertyInquirySubmission() {
      const propId = document.getElementById("inquiryPropertyTargetId").value.trim();
      const messageTextVal = document.getElementById("inquiryMessageText").value.trim();
      const customNameVal = document.getElementById("inquiryCustomName").value.trim();
      const customEmailVal = document.getElementById("inquiryCustomEmail").value.trim();
