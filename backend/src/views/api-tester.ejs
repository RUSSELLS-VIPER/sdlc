<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>API Tester</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="/assets/css/api-tester.css?v=20260603" rel="stylesheet" />
</head>
<body>
  <header class="topbar">
    <div class="container-fluid px-3 px-lg-4">
      <div class="topbar-inner">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-api btn-outline-api mobile-sidebar-trigger" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" aria-controls="sidebarOffcanvas" aria-label="Open navigation">
            <i class="bi bi-list"></i>
          </button>
          <div>
            <h1 class="page-title mb-0">API Tester</h1>
            <p class="page-subtitle mb-0">Lightweight request workspace for the local backend.</p>
          </div>
        </div>
        <div class="d-none d-md-flex align-items-center gap-2">
          <span class="soft-badge method-get"><i class="bi bi-lightning-charge"></i> Fast startup</span>
          <span class="soft-badge method-post"><i class="bi bi-palette"></i> Light theme</span>
        </div>
      </div>
    </div>
  </header>

  <div class="layout-shell">
    <aside class="sidebar-panel">
      <div class="sidebar-inner">
        <div id="sidebarNav">
          <div class="sidebar-heading">Navigation</div>

          <div class="sidebar-group">
            <button class="nav-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navDashboard" aria-expanded="true" aria-controls="navDashboard">
              <span><i class="bi bi-speedometer2 me-2"></i>Dashboard</span><i class="bi bi-chevron-down"></i>
            </button>
            <div class="collapse show mt-2" id="navDashboard">
              <button class="nav-pill active" type="button" data-section-target="section-dashboard"><span>Overview</span><i class="bi bi-arrow-right-short"></i></button>
            </div>
          </div>

          <div class="sidebar-group">
            <button class="nav-section-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navAuth" aria-expanded="false" aria-controls="navAuth">
              <span><i class="bi bi-shield-lock me-2"></i>Authentication</span><i class="bi bi-chevron-down"></i>
            </button>
            <div class="collapse mt-2" id="navAuth">
              <button class="nav-pill" type="button" data-section-target="section-auth"><span>Register</span><i class="bi bi-arrow-right-short"></i></button>
              <button class="nav-pill" type="button" data-section-target="section-auth"><span>Login</span><i class="bi bi-arrow-right-short"></i></button>
              <button class="nav-pill" type="button" data-section-target="section-auth"><span>Reset Password</span><i class="bi bi-arrow-right-short"></i></button>
            </div>
          </div>

          <div class="sidebar-group">
            <button class="nav-section-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navProperties" aria-expanded="false" aria-controls="navProperties">
              <span><i class="bi bi-building me-2"></i>Properties</span><i class="bi bi-chevron-down"></i>
            </button>
            <div class="collapse mt-2" id="navProperties">
              <button class="nav-pill" type="button" data-section-target="section-properties"><span>Create</span><i class="bi bi-arrow-right-short"></i></button>
              <button class="nav-pill" type="button" data-section-target="section-properties"><span>Browse</span><i class="bi bi-arrow-right-short"></i></button>
              <button class="nav-pill" type="button" data-section-target="section-properties"><span>Update</span><i class="bi bi-arrow-right-short"></i></button>
              <button class="nav-pill" type="button" data-section-target="section-properties"><span>Delete / Like</span><i class="bi bi-arrow-right-short"></i></button>
            </div>
          </div>

          <div class="sidebar-group">
            <button class="nav-section-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navUsers" aria-expanded="false" aria-controls="navUsers">
              <span><i class="bi bi-person-vcard me-2"></i>User Management</span><i class="bi bi-chevron-down"></i>
            </button>
            <div class="collapse mt-2" id="navUsers">
              <button class="nav-pill" type="button" data-section-target="section-users"><span>Profile</span><i class="bi bi-arrow-right-short"></i></button>
              <button class="nav-pill" type="button" data-section-target="section-users"><span>Update Profile</span><i class="bi bi-arrow-right-short"></i></button>
            </div>
          </div>

          <div class="sidebar-group">
            <button class="nav-section-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navFavorites" aria-expanded="false" aria-controls="navFavorites">
              <span><i class="bi bi-heart me-2"></i>Favorites</span><i class="bi bi-chevron-down"></i>
            </button>
            <div class="collapse mt-2" id="navFavorites">
              <button class="nav-pill" type="button" data-section-target="section-favorites"><span>Toggle</span><i class="bi bi-arrow-right-short"></i></button>
              <button class="nav-pill" type="button" data-section-target="section-favorites"><span>My List</span><i class="bi bi-arrow-right-short"></i></button>
            </div>
          </div>

          <div class="sidebar-group">
            <button class="nav-section-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navChat" aria-expanded="false" aria-controls="navChat">
              <span><i class="bi bi-chat-dots me-2"></i>Chat</span><i class="bi bi-chevron-down"></i>
            </button>
            <div class="collapse mt-2" id="navChat">
              <button class="nav-pill" type="button" data-section-target="section-chat"><span>Search</span><i class="bi bi-arrow-right-short"></i></button>
              <button class="nav-pill" type="button" data-section-target="section-chat"><span>History / Send</span><i class="bi bi-arrow-right-short"></i></button>
            </div>
          </div>

          <div class="sidebar-group mb-0">
            <button class="nav-section-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navAdmin" aria-expanded="false" aria-controls="navAdmin">
              <span><i class="bi bi-graph-up-arrow me-2"></i>Admin</span><i class="bi bi-chevron-down"></i>
            </button>
            <div class="collapse mt-2" id="navAdmin">
              <button class="nav-pill" type="button" data-section-target="section-admin"><span>Dashboard</span><i class="bi bi-arrow-right-short"></i></button>
              <button class="nav-pill" type="button" data-section-target="section-admin"><span>Customers</span><i class="bi bi-arrow-right-short"></i></button>
              <button class="nav-pill" type="button" data-section-target="section-admin"><span>Blogs</span><i class="bi bi-arrow-right-short"></i></button>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <main class="content-shell">
      <section class="token-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
          <div>
            <h2 class="panel-title">Request settings</h2>
            <p class="panel-subtitle mb-0">Set the base URL, token, and common IDs once, then reuse them across requests.</p>
          </div>
          <span class="soft-badge method-get"><i class="bi bi-window-stack"></i> Minimal layout</span>
        </div>
        <div class="row g-3">
          <div class="col-lg-3 col-md-6">
            <div class="form-floating">
              <input id="baseUrl" class="form-control" value="<%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>" placeholder="http://localhost:8000" />
              <label for="baseUrl">Base URL</label>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="form-floating">
              <input id="token" class="form-control" placeholder="Paste token or login to auto-fill" />
              <label for="token">JWT Token</label>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="form-floating">
              <input id="currentUserId" class="form-control" placeholder="Auto-filled after login" />
              <label for="currentUserId">Current User ID</label>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="form-floating">
              <input id="commonPropertyId" class="form-control" placeholder="Useful for favorites and property tests" />
              <label for="commonPropertyId">Common Property ID</label>
            </div>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <button id="saveToken" class="btn btn-api btn-primary-api px-4" type="button" data-action="auth.save-token"><i class="bi bi-save2 me-2"></i>Save Token</button>
          <button id="clearToken" class="btn btn-api btn-outline-api px-4" type="button" data-action="auth.clear-token"><i class="bi bi-eraser me-2"></i>Clear Token</button>
          <button class="btn btn-api btn-outline-api px-4" type="button" data-section-target="section-dashboard"><i class="bi bi-house-door me-2"></i>Overview</button>
        </div>
      </section>

      <div class="accordion api-section-accordion" id="apiTesterSections">
        <div class="accordion-item section-item">
          <h2 class="accordion-header" id="heading-dashboard">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#section-dashboard" aria-expanded="true" aria-controls="section-dashboard">
              <span>Dashboard</span>
            </button>
          </h2>
          <div id="section-dashboard" class="accordion-collapse collapse show" aria-labelledby="heading-dashboard" data-bs-parent="#apiTesterSections">
            <div class="accordion-body p-0" data-section-content="section-dashboard"></div>
          </div>
        </div>

        <div class="accordion-item section-item">
          <h2 class="accordion-header" id="heading-auth">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#section-auth" aria-expanded="false" aria-controls="section-auth">
              <span>Authentication</span>
            </button>
          </h2>
          <div id="section-auth" class="accordion-collapse collapse" aria-labelledby="heading-auth" data-bs-parent="#apiTesterSections">
            <div class="accordion-body p-0" data-section-content="section-auth"></div>
          </div>
        </div>

        <div class="accordion-item section-item">
          <h2 class="accordion-header" id="heading-properties">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#section-properties" aria-expanded="false" aria-controls="section-properties">
              <span>Properties</span>
            </button>
          </h2>
          <div id="section-properties" class="accordion-collapse collapse" aria-labelledby="heading-properties" data-bs-parent="#apiTesterSections">
            <div class="accordion-body p-0" data-section-content="section-properties"></div>
          </div>
        </div>

        <div class="accordion-item section-item">
          <h2 class="accordion-header" id="heading-users">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#section-users" aria-expanded="false" aria-controls="section-users">
              <span>User Management</span>
            </button>
          </h2>
          <div id="section-users" class="accordion-collapse collapse" aria-labelledby="heading-users" data-bs-parent="#apiTesterSections">
            <div class="accordion-body p-0" data-section-content="section-users"></div>
          </div>
        </div>

        <div class="accordion-item section-item">
          <h2 class="accordion-header" id="heading-favorites">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#section-favorites" aria-expanded="false" aria-controls="section-favorites">
              <span>Favorites</span>
            </button>
          </h2>
          <div id="section-favorites" class="accordion-collapse collapse" aria-labelledby="heading-favorites" data-bs-parent="#apiTesterSections">
            <div class="accordion-body p-0" data-section-content="section-favorites"></div>
          </div>
        </div>

        <div class="accordion-item section-item">
          <h2 class="accordion-header" id="heading-chat">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#section-chat" aria-expanded="false" aria-controls="section-chat">
              <span>Chat</span>
            </button>
          </h2>
          <div id="section-chat" class="accordion-collapse collapse" aria-labelledby="heading-chat" data-bs-parent="#apiTesterSections">
            <div class="accordion-body p-0" data-section-content="section-chat"></div>
          </div>
        </div>

        <div class="accordion-item section-item">
          <h2 class="accordion-header" id="heading-admin">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#section-admin" aria-expanded="false" aria-controls="section-admin">
              <span>Admin</span>
            </button>
          </h2>
          <div id="section-admin" class="accordion-collapse collapse" aria-labelledby="heading-admin" data-bs-parent="#apiTesterSections">
            <div class="accordion-body p-0" data-section-content="section-admin"></div>
          </div>
        </div>
      </div>

      <section class="response-panel">
        <div class="response-header">
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h2 class="panel-title mb-0">Response</h2>
              <span id="responseStatusBadge" class="soft-badge method-get">Status -</span>
            </div>
            <p class="panel-subtitle mt-1 mb-0">Rendered JSON with copy and clear actions.</p>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <button id="copyResponseBtn" class="btn btn-api btn-outline-api btn-sm" type="button" data-action="response.copy"><i class="bi bi-clipboard me-2"></i>Copy</button>
            <button id="clearResponseBtn" class="btn btn-api btn-secondary-api btn-sm" type="button" data-action="response.clear"><i class="bi bi-x-circle me-2"></i>Clear</button>
          </div>
        </div>
        <div class="response-body">
          <pre id="response" class="response-terminal"><span class="response-placeholder">Response will appear here...</span></pre>
        </div>
      </section>
    </main>
  </div>

  <div class="offcanvas offcanvas-start offcanvas-light" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
      <h5 class="offcanvas-title" id="sidebarOffcanvasLabel">Navigation</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-3">
      <div id="mobileNavHost"></div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script type="module" src="/assets/js/api-tester/main.js?v=20260603"></script>
</body>
</html>
