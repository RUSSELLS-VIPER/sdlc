{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{src/views/**,public/assets/**}"
    },
    "api/[...path].ts": {
      "maxDuration": 300,
      "includeFiles": "{src/views/**,public/assets/**}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ]
}
