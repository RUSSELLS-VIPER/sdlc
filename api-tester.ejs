    // Helper function to shift focused context to history tracking panel cards
    function selectUserForChat(userId) {
      document.getElementById("chatHistoryUserId").value = userId;
      loadChatHistory();
    }

    // Main chat records loader function sequence
    async function loadChatHistory() {
      const targetUserId = document.getElementById("chatHistoryUserId").value.trim();
      const banner = document.getElementById("chatParticipantBanner");
      const stream = document.getElementById("chatMessageStream");
      const currentUserId = document.getElementById("currentUserId").value.trim();

      if (!targetUserId) {
        alert("Please enter or pick an explicit target User ID context path parameter first.");
        return;
      }

      // Fire standard GET stream request
      const result = await sendRequest(`/api/users/history/${targetUserId}`, "GET", null, true);

      if (result.status !== 200 || !result.data) {
        banner.style.display = "none";
        stream.innerHTML = `<p style="font-size: 13px; color: #ef4444; text-align: center; margin: auto;">Failed to compile conversation log details error matrix.</p>`;
        return;
      }

      const { userContext, timeline } = result.data;

      // 1. Render banner layout information fields cleanly
      const bannerImg = userContext.profilePic || "https://cdn-icons-png.flaticon.com/512/149/149071.png";
      banner.style.display = "flex";
      banner.innerHTML = `
          <img src="${bannerImg}" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;" />
          <div>
            <div style="font-size: 13px; font-weight: bold; color: #1e293b;">${userContext.name} <span style="font-size: 10px; color: #64748b; font-weight: normal;">(${userContext.role})</span></div>
            <div style="font-size: 10px; color: #94a3b8;">Locality: ${userContext.locality} | District: ${userContext.district}</div>
          </div>
        `;

      // 2. Clear stream canvas and loop chronological timeline groupings
      stream.innerHTML = "";
      const timelineKeys = Object.keys(timeline);

      if (timelineKeys.length === 0) {
        stream.innerHTML = `<p style="font-size: 12px; color: #94a3b8; text-align: center; margin: auto;">Conversation initialized. No textual records found.</p>`;
        return;
      }

      timelineKeys.forEach(dateHeader => {
        // Date Separation bubble block rendering element creation
        const separator = document.createElement("div");
        separator.style = "text-align: center; margin: 6px 0; font-size: 10px; font-weight: bold; background: #e2e8f0; color: #475569; padding: 2px 8px; border-radius: 20px; align-self: center; text-transform: uppercase; letter-spacing: 0.5px;";
        separator.textContent = dateHeader;
        stream.appendChild(separator);

        // Loop message arrays grouped within this timeline index
        timeline[dateHeader].forEach(msg => {
          const bubbleRow = document.createElement("div");
          const isMe = msg.senderId === currentUserId;

          // Flex line assignments separating incoming vs outgoing bubbles
          bubbleRow.style = `display: flex; flex-direction: column; width: 100%; align-items: ${isMe ? 'flex-end' : 'flex-start'};`;

          const messageBubble = document.createElement("div");
          messageBubble.style = `
              max-width: 75%; 
              padding: 8px 12px; 
              border-radius: 12px; 
              font-size: 13px; 
              line-height: 1.4;
              word-break: break-word;
              box-shadow: 0 1px 2px rgba(0,0,0,0.05);
              background: ${isMe ? '#0f766e' : '#ffffff'}; 
              color: ${isMe ? '#ffffff' : '#1e293b'};
              border: ${isMe ? 'none' : '1px solid #e2e8f0'};
              border-bottom-${isMe ? 'right' : 'left'}-radius: 2px;
            `;

          messageBubble.innerHTML = `
              <div>${msg.messageText}</div>
              <div style="text-align: right; font-size: 9px; margin-top: 4px; color: ${isMe ? '#99f6e4' : '#94a3b8'}; font-weight: 500;">
                ${msg.timeLabel} ${isMe ? (msg.isRead ? '✓✓' : '✓') : ''}
              </div>
            `;

          bubbleRow.appendChild(messageBubble);
          stream.appendChild(bubbleRow);
        });
      });

      // Autoscroll to base node to show recent texts smoothly
      stream.scrollTop = stream.scrollHeight;
    }



    async function executeSendMessage() {
      const receiverId = document.getElementById("chatHistoryUserId").value.trim();
      const textInput = document.getElementById("chatOutgoingTextMessage");
      const messageText = textInput.value.trim();

      if (!receiverId) {
        alert("A valid recipient focus targets mapping ID must be selected to transmit messages.");
        return;
      }

      if (!messageText) {
        alert("Cannot send an empty message text canvas framework body.");
        return;
      }

      // Build object properties mapping for JSON consumption body array parsing pipelines
      const requestPayload = {
        receiverId: receiverId,
        messageText: messageText
      };

      // Fire request to your brand-new POST /api/users/chat/send route structure setup
      const result = await sendRequest("/api/users/chat/send", "POST", requestPayload, true);

      if (result.status === 201) {
        textInput.value = ""; // Clean input workspace canvas instantly

        // Smooth structural refresh - re-pull timeline frames so your text maps instantly onto the window UI
        await loadChatHistory();
      } else {
        alert("Failed to deliver payload transmission context framework layer rules. Check response details box logs.");
      }
    }




  </script>
