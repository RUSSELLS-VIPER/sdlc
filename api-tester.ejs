<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Real Estate API Tester</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #1f2937;
    }

    .container {
      max-width: 1100px;
      margin: 24px auto;
      padding: 0 16px;
    }

    h1 {
      margin-bottom: 8px;
    }

    .hint {
      margin-bottom: 16px;
      color: #4b5563;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 16px;
    }

    .card {
      background: #fff;
      border: 1px solid #dbe2ea;
      border-radius: 10px;
      padding: 14px;
    }

    .card h3 {
      margin: 0 0 12px;
    }

    label {
      display: block;
      font-size: 12px;
      margin-bottom: 5px;
      color: #4b5563;
    }

    input,
    select,
    button,
    textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 8px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      margin-bottom: 10px;
      font-size: 14px;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    button {
      border: none;
      cursor: pointer;
      background: #0f766e;
      color: #fff;
      font-weight: 600;
    }

    button:hover {
      background: #115e59;
    }

    .response {
      margin-top: 16px;
      background: #0f172a;
      color: #e2e8f0;
      border-radius: 10px;
      padding: 14px;
      white-space: pre-wrap;
      word-break: break-word;
      min-height: 220px;
    }

    .token-box {
      background: #fff;
      border: 1px solid #dbe2ea;
      border-radius: 10px;
      padding: 14px;
      margin-bottom: 16px;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .small {
      font-size: 12px;
      color: #6b7280;
      margin-top: -4px;
      margin-bottom: 8px;
    }
  </style>
</head>

<body>
  <div class="container">
    <h1>Real Estate API Tester</h1>
    <h2>
      Swagger Documentation <a href="http://localhost:8000/api-docs/">link</a>
    </h2>

    <div class="token-box">
      <div class="row">
        <div>
          <label for="baseUrl">Base URL (without /api path)</label>
          <input id="baseUrl" value="<%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>"
            placeholder="http://localhost:8000" />
        </div>
        <div>
          <label for="token">JWT Token</label>
          <input id="token" placeholder="Paste token or login to auto-fill" />
        </div>
      </div>
      <div class="row">
        <div>
          <label for="currentUserId">Current User ID</label>
          <input id="currentUserId" placeholder="Auto-filled after login" />
        </div>
        <div>
          <label for="commonPropertyId">Common Property ID</label>
          <input id="commonPropertyId" placeholder="Use for like/favorite/profile tests" />
        </div>
      </div>
      <button id="saveToken">Save Token</button>
    </div>

    <div class="grid">
      <div class="card">
        <h3>Register</h3>
        <label>Name</label>
        <input id="regName" value="Test User" />
        <label>Email</label>
        <input id="regEmail" value="test@example.com" />
        <label>Password</label>
        <input id="regPassword" type="password" value="123456" />
        <label>Role</label>
        <select id="regRole">
          <option value="user">user</option>
          <option value="agent">agent</option>
          <option value="admin">admin</option>
        </select>
        <button onclick="register()">POST /api/auth/register</button>
      </div>

      <div class="card">
        <h3>Verify Email</h3>
        <label>Email</label>
        <input id="verifyEmail" value="test@example.com" />
        <label>OTP</label>
        <input id="verifyOtp" placeholder="Enter OTP from email" />
        <button onclick="verifyEmail()">POST /api/auth/verify-email</button>
      </div>

      <div class="card">
        <h3>Login</h3>
        <label>Email</label>
        <input id="loginEmail" value="test@example.com" />
        <label>Password</label>
        <input id="loginPassword" type="password" value="123456" />
        <button onclick="login()">POST /api/auth/login</button>
      </div>

      <div class="card">
        <h3>Create Property</h3>
        <label>Title</label>
        <input id="createTitle" value="2BHK Apartment" />
        <label>Description</label>
        <textarea id="createDescription">
Near metro station, ready to move.</textarea>
        <label>Price</label>
        <input id="createPrice" value="7800000" />
        <label>Address</label>
        <input id="createAddress" value="Kolkata, India" />
        <label>BHK Type</label>
        <input id="createBhkType" value="2BHK" />
        <label>Sq.FT</label>
        <input id="createSqFt" value="1200" />
        <label>Apartment Type</label>
        <input id="createApartmentType" value="Apartment" />
        <label>Property Type</label>
        <select id="createPropertyType">
          <option value="apartment">apartment</option>
          <option value="home">home</option>
          <option value="office">office</option>
          <option value="villa">villa</option>
          <option value="rental">rental</option>
        </select>
        <label>Project Status</label>
        <select id="createProjectStatus">
          <option value="Completed">Completed</option>
          <option value="Ongoing">Ongoing</option>
        </select>
        <label>Image (optional)</label>
        <input id="createImage" type="file" accept="image/*" />
        <button onclick="createProperty()">POST /api/properties</button>
      </div>

      <div class="card">
        <h3>Get Properties</h3>
        <button onclick="getProperties()">GET /api/properties</button>
        <label>Property ID</label>
        <input id="propertyId" placeholder="Property id for get/update/delete" />
        <div class="small">Tip: you can reuse Common Property ID above</div>
        <button onclick="getPropertyById()">GET /api/properties/:id</button>
      </div>

      <div class="card">
        <h3>Update Property</h3>
        <label>Property ID</label>
        <input id="updateId" placeholder="Property id" />
        <label>Title (optional)</label>
        <input id="updateTitle" />
        <label>Description (optional)</label>
        <textarea id="updateDescription"></textarea>
        <label>Price (optional)</label>
        <input id="updatePrice" />
        <label>Address (optional)</label>
        <input id="updateAddress" />
        <label>BHK Type (optional)</label>
        <input id="updateBhkType" />
        <label>Sq.FT (optional)</label>
        <input id="updateSqFt" />
        <label>Apartment Type (optional)</label>
        <input id="updateApartmentType" />
        <label>Property Type (optional)</label>
        <select id="updatePropertyType">
          <option value="">-- Select --</option>
          <option value="apartment">apartment</option>
          <option value="home">home</option>
          <option value="office">office</option>
          <option value="villa">villa</option>
          <option value="rental">rental</option>
        </select>
        <label>Project Status (optional)</label>
        <select id="updateProjectStatus">
          <option value="">-- Select --</option>
          <option value="Completed">Completed</option>
          <option value="Ongoing">Ongoing</option>
        </select>
        <label>Image (optional)</label>
        <input id="updateImage" type="file" accept="image/*" />
        <button onclick="updateProperty()">PUT /api/properties/:id</button>
      </div>

      <div class="card">
        <h3>Delete Property</h3>
        <label>Property ID</label>
        <input id="deleteId" placeholder="Property id" />
        <button onclick="deleteProperty()">DELETE /api/properties/:id</button>
      </div>

      <div class="card">
        <h3>Like / Unlike Property</h3>
        <label>Property ID</label>
        <input id="likeId" placeholder="Property id" />
        <button onclick="toggleLike()">POST /api/properties/:id/like</button>
      </div>

      <div class="card">
        <h3>Get User Profile</h3>
        <label>User ID</label>
        <input id="profileUserId" placeholder="User id (or Current User ID)" />
        <button onclick="getUserProfile()">GET /api/users/profile/:id</button>
      </div>

      <div class="card">
        <h3>Update Profile</h3>
        <label>Name (optional)</label>
        <input id="profileName" placeholder="New name" />
        <label>Email (optional)</label>
        <input id="profileEmail" placeholder="New email" />


        <label>City (optional)</label>
        <input id="profileCity" placeholder="City" />
        <label>District (optional)</label>
        <input id="profileDistrict" placeholder="District" />
        <label>Locality (optional)</label>
        <input id="profileLocality" placeholder="Locality" />
        <label>Phone No. (optional)</label>
        <input id="profilePhoneNo" placeholder="Phone No." />


        <label>Profile Image (optional)</label>
        <input id="profileImage" type="file" accept="image/*" />
        <button onclick="updateUserProfile()">
          PUT /api/users/profile/update
        </button>
      </div>

      <div class="card">
        <h3>Toggle Favorite Property</h3>
        <label>Property ID</label>
        <input id="favoritePropertyId" placeholder="Property id" />
        <button onclick="toggleFavorite()">
          POST /api/users/favorites/:propertyId
        </button>
      </div>

      <div class="card">
        <h3>Get My Favorites</h3>
        <button onclick="getMyFavorites()">
          GET /api/users/favorites/my-list
        </button>
      </div>




      <div class="card" style="border-left: 4px solid #0f766e;">
        <h3>Search Chat Contacts</h3>
        <div class="small">Performs real-time role-based filtering using your session token.</div>

        <label for="chatSearchInput">Search by Name (Filters instantly)</label>
        <input id="chatSearchInput" placeholder="Type a username..." oninput="searchUsersToChat()" />

        <button onclick="searchUsersToChat()">GET /api/users/search-user-to-chat</button>

        <div id="chatSearchOutputContainer"
          style="margin-top: 12px; display: flex; flex-direction: column; gap: 8px; max-height: 250px; overflow-y: auto;">
          <p style="font-size: 13px; color: #6b7280; text-align: center; margin: 10px 0;">Start typing above to retrieve
            real-time data matches...</p>
        </div>
      </div>

      <div class="card" style="border-left: 4px solid #14b8a6; grid-column: span 1;">
        <h3>Chat History Log</h3>
        <div class="small">Renders a chronological bidirectional conversation thread between you and the target user.
        </div>

        <label for="chatHistoryUserId">Target User ID</label>
        <input id="chatHistoryUserId" placeholder="Click a user from search results or paste an explicit MongoDB ID" />

        <button onclick="loadChatHistory()">GET /api/users/history/:userId</button>

        <div id="chatHistoryWindow"
          style="margin-top: 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; display: flex; flex-direction: column; min-height: 280px; max-height: 350px;">

          <div id="chatParticipantBanner"
            style="background: #f1f5f9; border-bottom: 1px solid #e2e8f0; padding: 10px 14px; border-top-left-radius: 9px; border-top-right-radius: 9px; display: none; align-items: center; gap: 10px;">
          </div>

          <div id="chatMessageStream"
            style="flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 12px;">
            <p style="font-size: 13px; color: #6b7280; text-align: center; margin: auto;">Select an active user contact
              or provide an operational ID to trace timelines...</p>
          </div>

          <!-- Scrollable Message Stream Container -->
          <div id="chatMessageStream"
            style="flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 12px;">
            <p style="font-size: 13px; color: #6b7280; text-align: center; margin: auto;">Select an active user contact
              or provide an operational ID to trace timelines...</p>
          </div>

          <!-- Integrated Direct Message Despatcher Row Node -->
          <div id="chatInputBarArea"
            style="display: flex; gap: 8px; padding: 10px; background: #f1f5f9; border-top: 1px solid #e2e8f0; border-bottom-left-radius: 9px; border-bottom-right-radius: 9px;">
            <input id="chatOutgoingTextMessage" placeholder="Type your message text here..."
              style="margin-bottom: 0; flex: 1;" onkeydown="if(event.key === 'Enter') executeSendMessage()" />
            <button onclick="executeSendMessage()" style="margin-bottom: 0; width: auto; padding: 0 16px;">Send</button>
          </div>

        </div>
      </div>




      <div class="card" style="border-left: 4px solid #0f766e;">
        <h3>Admin Dashboard</h3>
        <div class="small">Requires authorization token with an 'admin' role.</div>

        <label>Timeframe (Part 3 Wave Graph)</label>
        <select id="adminTimeframe">
          <option value="month">Month (Default)</option>
          <option value="week">Week</option>
          <option value="year">Year</option>
        </select>

        <button onclick="getAdminDashboard()">GET /api/admin/dashboard</button>
      </div>

      <div class="card" style="border-left: 4px solid #0f766e;">
        <h3 style="margin: 0;">GET /api/admin/customers-list</h3>
        <div class="small" style="margin-bottom: 12px;">Fetch regular customer directory profile records with a limit
          index of 16 records per page slice.</div>

        <div style="display: flex; gap: 10px; margin-bottom: 10px; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 120px;">
            <label style="font-size: 11px;">Query Page Index</label>
            <input id="adminCustomerPageNum" type="number" value="1" min="1" style="margin-bottom: 0;" />
          </div>
          <div style="flex: 2; min-width: 200px;">
            <label style="font-size: 11px;">Search Parameter Text (Optional)</label>
            <input id="adminCustomerSearchText" placeholder="Filter by Name / Email fragment string..."
              style="margin-bottom: 0;" />
          </div>
        </div>

        <button onclick="testAdminCustomerListAPI()">Execute API Request Context</button>
      </div>




    </div>

    <pre id="response" class="response">Response will appear here...</pre>
  </div>

  <script>
    const tokenInput = document.getElementById("token");
    const baseUrlInput = document.getElementById("baseUrl");
    const responseBox = document.getElementById("response");
    const currentUserIdInput = document.getElementById("currentUserId");
    const commonPropertyIdInput = document.getElementById("commonPropertyId");

    if (!baseUrlInput.value) {
      baseUrlInput.value = window.location.origin;
    }

    tokenInput.value = localStorage.getItem("api_tester_token") || "";
    currentUserIdInput.value =
      localStorage.getItem("api_tester_user_id") || "";

    document.getElementById("saveToken").addEventListener("click", () => {
      localStorage.setItem("api_tester_token", tokenInput.value.trim());
      localStorage.setItem(
        "api_tester_user_id",
        currentUserIdInput.value.trim(),
      );
      writeResponse({ message: "Token saved in localStorage" }, 200);
    });

    function apiUrl(path) {
      return baseUrlInput.value.replace(/\/$/, "") + path;
    }

    function headers(authRequired = false, isFormData = false) {
      const h = {};
      if (!isFormData) {
        h["Content-Type"] = "application/json";
      }
      if (authRequired && tokenInput.value.trim()) {
        h.Authorization = "Bearer " + tokenInput.value.trim();
      }
      return h;
    }

    async function sendRequest(
      path,
      method,
      body,
      authRequired = false,
      isFormData = false,
    ) {
      const options = {
        method,
        headers: headers(authRequired, isFormData),
      };
      if (body) {
        options.body = isFormData ? body : JSON.stringify(body);
      }

      const res = await fetch(apiUrl(path), options);
      let data;
      try {
        data = await res.json();
      } catch (_e) {
        data = { raw: await res.text() };
      }
      writeResponse(data, res.status);
      return { status: res.status, data };
    }

    function writeResponse(data, status) {
      responseBox.textContent =
        "Status: " + status + "\n\n" + JSON.stringify(data, null, 2);
    }

    async function register() {
      await sendRequest("/api/auth/register", "POST", {
        name: document.getElementById("regName").value,
        email: document.getElementById("regEmail").value,
        password: document.getElementById("regPassword").value,
        role: document.getElementById("regRole").value,
      });
    }

    async function verifyEmail() {
      await sendRequest("/api/auth/verify-email", "POST", {
        email: document.getElementById("verifyEmail").value,
        otp: document.getElementById("verifyOtp").value,
      });
    }

    async function login() {
      const result = await sendRequest("/api/auth/login", "POST", {
        email: document.getElementById("loginEmail").value,
        password: document.getElementById("loginPassword").value,
      });
      if (result.status === 200 && result.data && result.data.token) {
        tokenInput.value = result.data.token;
        localStorage.setItem("api_tester_token", result.data.token);
        if (result.data.user && result.data.user.id) {
          currentUserIdInput.value = result.data.user.id;
          localStorage.setItem("api_tester_user_id", result.data.user.id);
        }
      }
    }

    async function createProperty() {
      const formData = new FormData();
      formData.append("title", document.getElementById("createTitle").value);
      formData.append(
        "description",
        document.getElementById("createDescription").value,
      );
      formData.append(
        "price",
        String(Number(document.getElementById("createPrice").value)),
      );
      formData.append(
        "address",
        document.getElementById("createAddress").value,
      );
      formData.append(
        "bhkType",
        document.getElementById("createBhkType").value,
      );
      formData.append("sqFt", document.getElementById("createSqFt").value);
      formData.append(
        "apartmentType",
        document.getElementById("createApartmentType").value,
      );
      formData.append(
        "propertyType",
        document.getElementById("createPropertyType").value,
      );
      formData.append(
        "projectStatus",
        document.getElementById("createProjectStatus").value,
      );

      const file = document.getElementById("createImage").files[0];
      if (file) formData.append("image", file);

      await sendRequest("/api/properties", "POST", formData, true, true);
    }

    async function getProperties() {
      await sendRequest("/api/properties", "GET");
    }

    async function getPropertyById() {
      const id = document.getElementById("propertyId").value;
      await sendRequest("/api/properties/" + id, "GET");
    }

    async function updateProperty() {
      const formData = new FormData();
      let hasPayload = false;
      const title = document.getElementById("updateTitle").value;
      const description = document.getElementById("updateDescription").value;
      const price = document.getElementById("updatePrice").value;
      const address = document.getElementById("updateAddress").value;
      const bhkType = document.getElementById("updateBhkType").value;
      const sqFt = document.getElementById("updateSqFt").value;
      const apartmentType = document.getElementById(
        "updateApartmentType",
      ).value;
      const propertyType =
        document.getElementById("updatePropertyType").value;
      const projectStatus = document.getElementById(
        "updateProjectStatus",
      ).value;
      const file = document.getElementById("updateImage").files[0];

      if (title) {
        formData.append("title", title);
        hasPayload = true;
      }
      if (description) {
        formData.append("description", description);
        hasPayload = true;
      }
      if (price) {
        formData.append("price", String(Number(price)));
        hasPayload = true;
      }
      if (address) {
        formData.append("address", address);
        hasPayload = true;
      }
      if (bhkType) {
        formData.append("bhkType", bhkType);
        hasPayload = true;
      }
      if (sqFt) {
        formData.append("sqFt", sqFt);
        hasPayload = true;
      }
      if (apartmentType) {
        formData.append("apartmentType", apartmentType);
        hasPayload = true;
      }
      if (propertyType) {
        formData.append("propertyType", propertyType);
        hasPayload = true;
      }
      if (projectStatus) {
        formData.append("projectStatus", projectStatus);
        hasPayload = true;
      }
      if (file) {
        formData.append("image", file);
        hasPayload = true;
      }

      const id = document.getElementById("updateId").value;
      if (!hasPayload) {
        writeResponse(
          { message: "Add at least one field or image to update" },
          400,
        );
        return;
      }

      await sendRequest("/api/properties/" + id, "PUT", formData, true, true);
    }

    async function deleteProperty() {
      const id = document.getElementById("deleteId").value;
      await sendRequest("/api/properties/" + id, "DELETE", null, true);
    }

    async function toggleLike() {
      const id =
        document.getElementById("likeId").value ||
        commonPropertyIdInput.value;
      await sendRequest(
        "/api/properties/" + id + "/like",
        "POST",
        null,
        true,
      );
    }

    async function getUserProfile() {
      const id =
        document.getElementById("profileUserId").value ||
        currentUserIdInput.value;
      await sendRequest("/api/users/profile/" + id, "GET", null, true);
    }

    async function updateUserProfile() {
      const formData = new FormData();
      let hasPayload = false;

      const name = document.getElementById("profileName").value;
      const email = document.getElementById("profileEmail").value;

      const city = document.getElementById("profileCity").value;
      const district = document.getElementById("profileDistrict").value;
      const locality = document.getElementById("profileLocality").value;
      const phoneNo = document.getElementById("profilephoneNo").value;

      const file = document.getElementById("profileImage").files[0];

      if (name) {
        formData.append("name", name);
        hasPayload = true;
      }
      if (email) {
        formData.append("email", email);
        hasPayload = true;
      }


      if (city) {
        formData.append("city", city);
        hasPayload = true;
      }

      if (district) {
        formData.append("district", district);
        hasPayload = true;
      }
      if (locality) {
        formData.append("locality", locality);
        hasPayload = true;
      }

      if (phoneNo) {
        formData.append("phoneNo", phoneNo);
        hasPayload = true;
      }

      if (file) {
        formData.append("image", file);
        hasPayload = true;
      }

      if (!hasPayload) {
        writeResponse(
          { message: "Add at least one field or profile image to update" },
          400,
        );
        return;
      }

      await sendRequest(
        "/api/users/profile/update",
        "PUT",
        formData,
        true,
        true,
      );
    }

    async function toggleFavorite() {
      const propertyId =
        document.getElementById("favoritePropertyId").value ||
        commonPropertyIdInput.value;
      await sendRequest(
        "/api/users/favorites/" + propertyId,
        "POST",
        null,
        true,
      );
    }

    async function getMyFavorites() {
      await sendRequest("/api/users/favorites/my-list", "GET", null, true);
    }








    async function getAdminDashboard() {
      const timeframe = document.getElementById("adminTimeframe").value;
      await sendRequest("/api/admin/dashboard?timeframe=" + timeframe, "GET", null, true);
    }

    // Automatically fetch fresh chart data when changing the dropdown option
    document.getElementById("adminTimeframe").addEventListener("change", () => {
      getAdminDashboard();
    });


    async function testAdminCustomerListAPI() {
      const pageIndex = document.getElementById("adminCustomerPageNum").value || 1;
      const searchString = document.getElementById("adminCustomerSearchText").value.trim();

      // Build path query parameters dynamically matching backend constraints structure
      let requestUrlPath = `/api/admin/customers-list?page=${pageIndex}`;
      if (searchString) {
        requestUrlPath += `&search=${encodeURIComponent(searchString)}`;
      }

      // Fire request directly through your base application handler sequence wrapper
      // Assumes your global base utility is named sendRequest(url, method, body, hasToken)
      const apiResponsePayload = await sendRequest(requestUrlPath, "GET", null, true);

      // Map data directly into your terminal screen logging element block window interface
      if (typeof writeResponse === "function") {
        writeResponse(apiResponsePayload.data, apiResponsePayload.status);
      } else {
        console.log(`API Output Matrix Frame (${apiResponsePayload.status}):`, apiResponsePayload.data);
      }
    }





    //chat system script code for all users
    async function searchUsersToChat() {
      const query = document.getElementById("chatSearchInput").value.trim();
      const container = document.getElementById("chatSearchOutputContainer");

      // Re-use your existing sendRequest utility pipeline
      // passes 'true' for authRequired since this API requires route authentication
      const result = await sendRequest(`/api/users/search-user-to-chat?search=${encodeURIComponent(query)}`, "GET", null, true);

      // If the request fails or is empty, provide a clean fallback state
      if (result.status !== 200 || !Array.isArray(result.data)) {
        container.innerHTML = `<p style="font-size: 13px; color: #ef4444; text-align: center; margin: 10px 0;">Failed to fetch records or unauthorized access.</p>`;
        return;
      }

      const usersList = result.data;
      container.innerHTML = "";

      if (usersList.length === 0) {
        container.innerHTML = `<p style="font-size: 13px; color: #6b7280; text-align: center; margin: 10px 0;">No matching users found.</p>`;
        return;
      }

      // Programmatically render items as per your specific aggregation pipeline keys
      usersList.forEach(user => {
        const userRow = document.createElement("div");
        userRow.style = "display: flex; align-items: center; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; padding: 8px; border-radius: 8px; box-shadow: 0 1px 2px rgba(0,0,0,0.02);";

        // Image Fallback Handling if binary objects/URLs are missing or unconfigured
        const imageSrc = (user.profilePic && typeof user.profilePic === 'string')
          ? user.profilePic
          : "https://cdn-icons-png.flaticon.com/512/149/149071.png";

        // Format sub-text elements nicely using locality indicators
        const locationText = (user.locality || user.district)
          ? `(${user.locality || ''} ${user.district || ''})`
          : '';

        userRow.innerHTML = `
            <img src="${imageSrc}" alt="Avatar" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover; background: #cbd5e1;" />
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                <strong style="font-size: 14px; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${user.name}</strong>
                <span style="font-size: 10px; font-weight: bold; background: #e2e8f0; color: #475569; padding: 2px 6px; border-radius: 4px;">${user.role || 'USER'}</span>
              </div>
              <div style="font-size: 11px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-style: italic;">
                💬 ${user.latestMessageText}
              </div>
              <div style="font-size: 9px; color: #94a3b8; margin-top: 2px;">
                ${locationText}
              </div>
            </div>
          `;
        container.appendChild(userRow);
      });
    }



    // UPDATED: Now supports click targeting events on contact rows
    async function searchUsersToChat() {
      const query = document.getElementById("chatSearchInput").value.trim();
      const container = document.getElementById("chatSearchOutputContainer");

      const result = await sendRequest(`/api/users/search-user-to-chat?search=${encodeURIComponent(query)}`, "GET", null, true);

      if (result.status !== 200 || !Array.isArray(result.data)) {
        container.innerHTML = `<p style="font-size: 13px; color: #ef4444; text-align: center; margin: 10px 0;">Failed to fetch records or unauthorized access.</p>`;
        return;
      }

      const usersList = result.data;
      container.innerHTML = "";

      if (usersList.length === 0) {
        container.innerHTML = `<p style="font-size: 13px; color: #6b7280; text-align: center; margin: 10px 0;">No matching users found.</p>`;
        return;
      }

      usersList.forEach(user => {
        const userRow = document.createElement("div");
        // Added pointer mouse effects and operational click handler attributes
        userRow.style = "display: flex; align-items: center; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; padding: 8px; border-radius: 8px; box-shadow: 0 1px 2px rgba(0,0,0,0.02); cursor: pointer; transition: background 0.2s;";
        userRow.setAttribute("onclick", `selectUserForChat('${user._id}')`);

        // Hover states simulation logic updates
        userRow.onmouseenter = () => userRow.style.background = "#f1f5f9";
        userRow.onmouseleave = () => userRow.style.background = "#f8fafc";

        const imageSrc = (user.profilePic && typeof user.profilePic === 'string')
          ? user.profilePic
          : "https://cdn-icons-png.flaticon.com/512/149/149071.png";

        const locationText = (user.locality || user.district) ? `(${user.locality || ''} ${user.district || ''})` : '';

        userRow.innerHTML = `
            <img src="${imageSrc}" alt="Avatar" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;" />
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                <strong style="font-size: 13px; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${user.name}</strong>
                <span style="font-size: 9px; font-weight: bold; background: #cbd5e1; color: #334155; padding: 1px 5px; border-radius: 4px;">${user.role || 'USER'}</span>
              </div>
              <div style="font-size: 11px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
